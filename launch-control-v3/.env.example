# Launch Control v3 — Environment Variables
# Copy this to .env and fill in values
# NEVER commit .env to git

# Alpaca API — rotate keys after each session
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets
ALPACA_FEED=sip

# Database — existing Render Postgres, v3 uses lc_v3 schema
DATABASE_URL=postgresql://alphatrades_db_user:password@host/alphatrades_db

# App
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Account
ACCOUNT_SIZE=7500
