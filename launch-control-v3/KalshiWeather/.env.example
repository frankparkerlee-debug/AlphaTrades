# Kalshi API (https://kalshi.com/account/api-keys)
KALSHI_API_KEY=your-key-id-here
# Paste the full PEM inline (replace newlines with \n):
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----

# Environment: "demo" or "prod"
KALSHI_ENV=demo

# Paper trading (true = no real orders)
PAPER_TRADING=true

# Anthropic (for AI-assisted analysis, optional)
ANTHROPIC_API_KEY=sk-ant-...

# Capital
STARTING_CAPITAL=500

# State/log directory
STATE_DIR=./logs
