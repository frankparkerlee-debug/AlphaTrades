# ── Alpaca LIVE keys (market data only) ──────────────────────────────────────
# Used by: StockHistoricalDataClient, OptionHistoricalDataClient, tape monitor
# These hit live data endpoints — no base URL needed
ALPACA_API_KEY=your_live_api_key_here
ALPACA_API_SECRET=your_live_api_secret_here

# ── Alpaca PAPER keys (order execution only) ─────────────────────────────────
# Used by: TradingClient — order submission, position tracking, account balance
ALPACA_PAPER_API_KEY=your_paper_api_key_here
ALPACA_PAPER_API_SECRET=your_paper_api_secret_here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Risk controls
KILL_SWITCH_THRESHOLD=-800
PDT_FLOOR=25000
PDT_ALERT_BUFFER=26500
MAX_OPS_PER_SECOND=5
TTL_SECONDS=60
TAPE_LOOKBACK_SECONDS=60
TAPE_MIN_PRINTS=3
MAX_CONCURRENT_POSITIONS=8

# Strategy parameters
CONTRACTS_PER_TRADE=10
SPREAD_CAPTURE_PCT=0.40
TARGET_DTE_MIN=7
TARGET_DTE_MAX=14
OTM_PCT_MIN=0.01
OTM_PCT_MAX=0.03
MIN_SPREAD_WIDTH=0.13
MIN_DAILY_VOLUME=150

# Universe
UNIVERSE=JPM,GS,BAC,MS,WFC
